generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS DEL NEGOCIO (SRS & MCUN)
// ==========================================

enum Role {
  // Roles del Consultorio Jurídico (SRS 2.2 / MCUN Actores)
  DIRECTOR
  DOCENTE_SUPERVISOR
  PASANTE
  ADMINISTRATIVO
  CLIENTE
  ADMIN_TI

  // Roles heredados (mantenidos para retrocompatibilidad inmediata)
  admin
  user
  auditor
}

enum AreaJuridica {
  CIVIL
  LABORAL
  PENAL
  FAMILIA
  PUBLICO
}

enum EstadoExpediente {
  ADMITIDO
  ASIGNADO
  EN_TRAMITE
  EN_REVISION_DOCENTE
  PENDIENTE_CIERRE
  ARCHIVADO
}

enum NivelSensibilidad {
  NORMAL
  MAXIMA_SENSIBILIDAD // NNA o víctimas de violencia (Ley 1581 / RF-04)
}

enum TipoDocumentoIdentidad {
  CC
  TI
  CE
  PPT
  PASAPORTE
}

enum EstadoTurno {
  EN_ESPERA
  ATENDIENDO
  FINALIZADO
  CANCELADO
}

enum TipoEscrito {
  TUTELA
  DEMANDA
  DERECHO_PETICION
  RECURSO
  CONCILIACION
  MEMORIAL
  OTRO
}

enum EstadoEscrito {
  BORRADOR
  EN_REVISION
  APROBADO
  RECHAZADO
}

enum TipoActuacion {
  AUDIENCIA
  NOTIFICACION_JUZGADO
  RADICACION_MEMORIAL
  AUTO_INTERLOCUTORIO
  SENTENCIA
  ENTREGA_DOCUMENTOS
  OTRO
}

enum Permission {
  owner
  read
}

enum DocumentStatus {
  active
  deleted
}

enum TipoDocumental {
  PODER
  PRUEBA
  DOCUMENTO_IDENTIDAD
  MEMORIAL
  ACTA_CONCILIACION
  SENTENCIA
  OTRO
}

enum AuditAction {
  // Acciones de autenticación y usuario
  USER_REGISTERED
  USER_LOGGED_IN
  USER_ROLE_CHANGED
  USER_DISABLED
  USER_ENABLED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  CONFIDENCIALIDAD_FIRMADA
  PASANTE_EGRESADO_REVOCADO

  // Acciones sobre archivos y carpetas (existentes)
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_ACCESS_DENIED
  DOCUMENT_SHARED
  DOCUMENT_UNSHARED
  DOCUMENT_DELETED
  DOCUMENT_RESTORED
  DOCUMENT_VERSION_CREATED
  DOCUMENT_MOVED
  FOLDER_CREATED
  FOLDER_DELETED

  // Nuevas acciones del Consultorio Jurídico (SRS RNF-03)
  EXPEDIENTE_CREADO
  EXPEDIENTE_ASIGNADO
  EXPEDIENTE_REASIGNADO
  CONFLICTO_INTERES_BLOQUEADO
  ESCRITO_CREADO
  ESCRITO_ENVIADO_REVISION
  ESCRITO_APROBADO
  ESCRITO_RECHAZADO
  ACTUACION_REGISTRADA
  CIERRE_EXPEDIENTE_SOLICITADO
  EXPEDIENTE_ARCHIVADO
}

// ==========================================
// MODELOS DE USUARIOS Y GESTIÓN ACADÉMICA
// ==========================================

model User {
  id                         String         @id @default(uuid())
  email                      String         @unique
  passwordHash               String
  name                       String
  role                       Role           @default(user)
  isActive                   Boolean        @default(true)
  telefono                   String?
  documentoIdentidad         String?
  areaAsignada               AreaJuridica?  // Área temática de práctica o supervisión
  acuerdoConfidencialidad    Boolean        @default(false) // RN01, RF-14
  fechaFirmaConfidencialidad DateTime?
  fechaEgreso                DateTime?      // RN03, RF-15 (fecha límite de acceso)
  maxCasosActivos            Int            @default(5)     // RN06 (control de carga)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  // Relaciones documentales existentes
  documents                  Document[]
  permissions                DocumentPermission[]
  auditLogs                  AuditLog[]
  folders                    Folder[]

  // Relaciones jurídicas del consultorio
  expedientesComoDocente     Expediente[]         @relation("DocenteExpedientes")
  expedientesComoPasante     Expediente[]         @relation("PasanteExpedientes")
  expedientesCreados         Expediente[]         @relation("CreadorExpedientes")
  escritosElaborados         EscritoProcesal[]    @relation("AutorEscritos")
  escritosRevisados          EscritoProcesal[]    @relation("RevisorEscritos")
  actuacionesRegistradas     ActuacionProcesal[]
  turnosAtendidos            TurnoAtencion[]
}

// ==========================================
// MODELOS DE ATENCIÓN Y ADMISIÓN (CUN-01)
// ==========================================

model Cliente {
  id                         String                  @id @default(uuid())
  tipoDocumento              TipoDocumentoIdentidad  @default(CC)
  numeroDocumento            String                  @unique
  nombreCompleto             String
  telefono                   String?
  email                      String?
  direccion                  String?
  estrato                    Int                     // Estrato socioeconómico (1-3 vulnerable)
  grupoSisben                String?                 // Categorización Sisbén (ej: A1, B2)
  declaracionIndefension     Boolean                 @default(false)
  esVictimaViolencia         Boolean                 @default(false)
  esMenorEdad                Boolean                 @default(false)
  indiceVulnerabilidad       Float?                  // Índice calculado según Ley 2113 (RF-02)
  consentimientoHabeasData   Boolean                 @default(false) // RF-01 obligatorio
  fechaConsentimiento        DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  turnos                     TurnoAtencion[]
  expedientes                Expediente[]
}

model TurnoAtencion {
  id             String      @id @default(uuid())
  numeroTurno    Int         // Secuencial diario (RF-01)
  fecha          DateTime    @default(now())
  estado         EstadoTurno @default(EN_ESPERA)
  clienteId      String
  cliente        Cliente     @relation(fields: [clienteId], references: [id])
  atendidoPorId  String?
  atendidoPor    User?       @relation(fields: [atendidoPorId], references: [id])
  observaciones  String?
  createdAt      DateTime    @default(now())
}

// ==========================================
// MODELO DE EXPEDIENTES (CUN-02, CUN-03, CUN-07)
// ==========================================

model Expediente {
  id                     String              @id @default(uuid())
  radicado               String              @unique // Único e irrepetible, ej: CJ-2026-0001 (RF-04)
  areaJuridica           AreaJuridica        // RF-03
  tipoCaso               String              // Ej: "Acción de Tutela", "Fijación de Alimentos"
  hechos                 String?             @db.Text
  pretensiones           String?             @db.Text
  sensibilidad           NivelSensibilidad   @default(NORMAL) // Si es sensible, solo Docente y Director (RN02)
  estado                 EstadoExpediente    @default(ADMITIDO)
  
  // Detección de conflicto de intereses (RF-06, RN06)
  contraparteNombre      String?
  contraparteDocumento   String?

  clienteId              String
  cliente                Cliente             @relation(fields: [clienteId], references: [id])
  
  docenteSupervisorId    String?
  docenteSupervisor      User?               @relation("DocenteExpedientes", fields: [docenteSupervisorId], references: [id])
  
  pasanteId              String?
  pasante                User?               @relation("PasanteExpedientes", fields: [pasanteId], references: [id])
  
  creadoPorId            String?
  creadoPor              User?               @relation("CreadorExpedientes", fields: [creadoPorId], references: [id])

  fechaApertura          DateTime            @default(now())
  fechaAsignacion        DateTime?
  fechaCierre            DateTime?
  motivoCierre           String?
  
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  // Relaciones operativas
  documentos             Document[]          // Documentos cifrados vinculados al caso
  escritos               EscritoProcesal[]   // Tutelas, demandas y recursos
  actuaciones            ActuacionProcesal[] // Historial y términos procesales
  solicitudCierre        SolicitudCierre?
}

// ==========================================
// ESCRITOS Y SEGUIMIENTO PROCESAL (CUN-04, CUN-05)
// ==========================================

model EscritoProcesal {
  id                    String         @id @default(uuid())
  expedienteId          String
  expediente            Expediente     @relation(fields: [expedienteId], references: [id])
  autorId               String
  autor                 User           @relation("AutorEscritos", fields: [autorId], references: [id])
  
  titulo                String
  tipo                  TipoEscrito
  contenido             String         @db.Text
  version               Int            @default(1)
  estado                EstadoEscrito  @default(BORRADOR) // Borrador -> En Revisión -> Aprobado (RF-08)
  
  observacionesDocente  String?        @db.Text // Retroalimentación pedagógica (CUN-05)
  revisadoPorId         String?
  revisadoPor           User?          @relation("RevisorEscritos", fields: [revisadoPorId], references: [id])
  
  fechaEnvioRevision    DateTime?
  fechaAprobacion       DateTime?
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ActuacionProcesal {
  id                     String         @id @default(uuid())
  expedienteId           String
  expediente             Expediente     @relation(fields: [expedienteId], references: [id])
  registradoPorId        String
  registradoPor          User           @relation(fields: [registradoPorId], references: [id])
  
  tipo                   TipoActuacion
  descripcion            String         @db.Text
  fechaActuacion         DateTime       @default(now())
  
  // Alertas tempranas de términos (7, 3 y 1 día antes) (RF-09)
  fechaVencimientoTermino DateTime?
  terminoCumplido        Boolean        @default(false)
  
  documentoSoporteId     String?        // ID de Document opcional asociado
  
  createdAt              DateTime       @default(now())
}

model SolicitudCierre {
  id                           String     @id @default(uuid())
  expedienteId                 String     @unique
  expediente                   Expediente @relation(fields: [expedienteId], references: [id])
  
  informeFinalPasante          String     @db.Text
  avalDocente                  Boolean    @default(false)
  observacionesDocente         String?    @db.Text
  
  aprobacionDirector           Boolean    @default(false)
  observacionesDirector        String?    @db.Text
  devolucionOriginalesUsuario  Boolean    @default(false) // Ley 594 de 2000 (RF-12)
  
  fechaSolicitud               DateTime   @default(now())
  fechaAprobacion              DateTime?
}

// ==========================================
// GESTIÓN DE ARCHIVOS CIFRADOS (EXISTENTE)
// ==========================================

model Folder {
  id        String     @id @default(uuid())
  name      String
  ownerId   String
  parentId  String?
  createdAt DateTime   @default(now())

  owner     User       @relation(fields: [ownerId], references: [id])
  parent    Folder?    @relation("FolderChildren", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderChildren")
  documents Document[]
}

model Document {
  id                String             @id @default(uuid())
  ownerId           String
  originalName      String
  mimeType          String
  size              Int
  sha256            String
  storageKey        String             @unique
  encryptionIv      String
  encryptionAuthTag String
  status            DocumentStatus     @default(active)
  folderId          String?
  
  // Asociación opcional al expediente del consultorio (RF-05)
  expedienteId      String?
  tipoDocumental    TipoDocumental?    @default(OTRO)
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id])
  folder            Folder?            @relation(fields: [folderId], references: [id])
  expediente        Expediente?        @relation(fields: [expedienteId], references: [id])
  permissions       DocumentPermission[]
  versions          DocumentVersion[]
}

model DocumentVersion {
  id                String   @id @default(uuid())
  documentId        String
  versionNumber     Int
  originalName      String
  mimeType          String
  size              Int
  sha256            String
  storageKey        String   @unique
  encryptionIv      String
  encryptionAuthTag String
  createdAt         DateTime @default(now())

  document          Document @relation(fields: [documentId], references: [id])
}

model DocumentPermission {
  id         String     @id @default(uuid())
  documentId String
  userId     String
  permission Permission
  createdAt  DateTime   @default(now())

  document   Document   @relation(fields: [documentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([documentId, userId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityType String?
  entityId   String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor      User?       @relation(fields: [actorId], references: [id])
}
